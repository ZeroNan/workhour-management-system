# 工时管理系统 环境变量示例（此文件可提交，仅作模板，不含真实密码）
# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，不会进入版本库/交付物
# 也可在启动命令前以 PORT=3456 DB_HOST=... npm start 形式覆盖（无需 dotenv）

PORT=3456

# MySQL 连接（将下方占位符替换为你的真实数据库信息）
# 注意：生产/私有环境的 host、账号、密码请勿提交到版本库
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-db-user
# 若密码含 # 或 @ 等符号，必须用英文双引号包裹，否则 # 会被当作注释截断
DB_PASSWORD="your-strong-password"
DB_NAME=your-db-name
